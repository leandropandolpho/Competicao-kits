{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(pwsh -NoProfile -File testes/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git log *)",
      "PowerShell(pwsh -NoProfile -File testes/*)"
    ],
    "deny": [
      "Edit(./testes/**)",
      "Edit(./tests/**)",
      "Edit(./**/*.test.*)",
      "Edit(./**/*.spec.*)",
      "Edit(./**/*migration*/**)",
      "Edit(./**/package.json)",
      "Edit(./**/package-lock.json)",
      "Edit(./**/requirements.txt)",
      "Edit(./**/pyproject.toml)",
      "Edit(./.claude/**)",
      "Edit(./.git/**)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(Start-Process *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
