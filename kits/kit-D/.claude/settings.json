{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(pwsh:*)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(Remove-Item:*)",
      "Bash(Invoke-Expression:*)",
      "Bash(Start-Process:*)",
      "Bash(curl:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(git push:*)",
      "Edit(./testes/*)",
      "Edit(./spec/*)"
    ]
  }
}
