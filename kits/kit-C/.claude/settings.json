{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(**)",
      "Edit(/src/**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(pwsh -NoProfile -File testes/*)",
      "Bash(pwsh -NoProfile -Command *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(pwsh -NoProfile -File testes/*)",
      "PowerShell(pwsh -NoProfile -Command *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Select-String *)"
    ],
    "deny": [
      "Edit(/testes/**)",
      "Edit(/tests/**)",
      "Edit(/spec/**)",
      "Edit(**/*.test.*)",
      "Edit(**/*.spec.*)",
      "Edit(**/*migration*)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/requirements.txt)",
      "Edit(/pyproject.toml)",
      "Edit(../**)",
      "Bash(rm * ../*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ../*)",
      "Bash(del * ../*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(*Invoke-Expression*)",
      "Bash(*Start-Process*)",
      "PowerShell(Remove-Item *..*)",
      "PowerShell(Remove-Item /*)",
      "PowerShell(Remove-Item \\*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(iex *)",
      "PowerShell(Start-Process *)",
      "PowerShell(saps *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(iwr *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(irm *)",
      "PowerShell(curl *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)"
    ]
  }
}
